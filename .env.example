# medAgent-CRM environment variables.
# Copy to .env and fill in real values. New specs add to this file as they
# introduce new env vars (see steering/02-code-quality.md).

# --- Postgres (MEDGENT-002/003) ---
# Used by docker-compose.yml's postgres service and by the backend's
# DATABASE_URL below. Change the password before using this anywhere but
# local dev.
POSTGRES_USER=medagent
POSTGRES_PASSWORD=medagent_dev_password
POSTGRES_DB=medagent_crm

# Backend's connection string. Host is "postgres" (the Compose service
# name) when running via docker compose, or "localhost" when running the
# backend directly against a locally-installed Postgres. Uses the psycopg
# (v3) driver — keep the "+psycopg" in the scheme.
DATABASE_URL=postgresql+psycopg://medagent:medagent_dev_password@postgres:5432/medagent_crm

# --- Backend app (MEDGENT-005) ---
# Single hardcoded demo rep id — no auth system in this build. Must match
# the row inserted by the alembic/versions/*_seed_demo_rep.py migration.
# Safe to omit; this is also the field's default.
DEFAULT_REP_ID=00000000-0000-0000-0000-000000000001

# Comma-separated list of origins the backend's CORS allows. The Vite dev
# server's default port is included by default; add more if needed.
CORS_ORIGINS=http://localhost:5173

# --- Groq / LangGraph agent (MEDGENT-009) ---
# Not consumed until MEDGENT-009 wires up the Groq client.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_DEFAULT=gemma2-9b-it
GROQ_MODEL_HEAVY=llama-3.3-70b-versatile

# API base URL for the frontend lands with MEDGENT-017.
